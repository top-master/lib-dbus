import argparse
import glob
import os
import subprocess
import sys


def annotate_xml(filename, copyright_text, license_expr):
    with open(filename, "r", encoding="utf-8") as f:
        content = f.read()

    # REUSE-IgnoreStart
    header = (
        "\n"
        "<!--\n"
        f"SPDX-FileCopyrightText: {copyright_text}\n"
        f"\n"
        f"SPDX-License-Identifier: {license_expr}\n"
        "-->\n"
    )
    # REUSE-IgnoreEnd


    # Already annotated?
    # REUSE-IgnoreStart
    if "SPDX-License-Identifier:" in content:
        return
    # REUSE-IgnoreEnd

    # Preserve XML declaration if present.
    if content.startswith("<?xml"):
        end = content.find("?>")
        if end != -1:
            end += 2
            content = content[:end] + "\n" + header + content[end:]
        else:
            content = header + content
    else:
        content = header + content

    with open(filename, "w", encoding="utf-8") as f:
        f.write(content)


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("-c", "--copyright", required=True)
    parser.add_argument("-l", "--license", required=True)
    parser.add_argument("files", nargs="+")

    args = parser.parse_args()

    for pattern in args.files:
        matched = glob.glob(pattern)
        if not matched:
            matched = [pattern]

        for filename in matched:
            if filename.endswith(".xml") or filename.endswith(".xml.in") or filename.endswith(".conf"):
                annotate_xml(
                    filename,
                    args.copyright,
                    args.license,
                )
            else:
                subprocess.run(
                    [
                        "reuse",
                        "annotate",
                        "-c",
                        args.copyright,
                        "-l",
                        args.license,
                        filename,
                    ],
                    check=True,
                )


if __name__ == "__main__":
    sys.exit(main())
